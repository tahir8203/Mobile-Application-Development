<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MAD" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:colorPrimary">@color/electric</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>

    <style name="Theme.MAD.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MAD</item>
    </style>
</resources>
